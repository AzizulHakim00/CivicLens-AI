{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civiclens-ai",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "civiclens-production-db",
      "database_id": "c56e8044-5603-413a-a0f4-fde59cd9202b",
      "migrations_dir": "drizzle"
    }
  ]
}
